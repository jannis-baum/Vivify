  "author": "Jannis Baum",
  "scripts": {
    "dev": "VIV_TIMEOUT=0 VIV_PORT=3000 NODE_ENV=development nodemon --ignore tests/rendering/symlinks --exec node --import ./loader.mjs src/app.ts",
